@import "../shared.wxss";

.report-detail-page { min-height: 100vh; padding: 0; overflow: hidden; background: #f4f0e7; }
.locked-viewport { position: relative; min-height: 100vh; overflow: hidden; background: #211915; }
.locked-topbar { position: absolute; top: calc(env(safe-area-inset-top) + 24rpx); right: 32rpx; left: 32rpx; z-index: 8; display: flex; align-items: center; justify-content: space-between; }
.locked-topbar .photo-icon { background: rgba(31,23,19,.26); }.locked-topbar .icon-image { filter: brightness(0) invert(1); }.topbar-spacer { width: 84rpx; height: 84rpx; }
.locked-tabs { position: absolute; top: calc(env(safe-area-inset-top) + 136rpx); left: 50%; z-index: 8; display: flex; gap: 10rpx; padding: 8rpx; border: 1rpx solid rgba(255,253,248,.25); border-radius: 999rpx; background: rgba(31,23,19,.26); transform: translateX(-50%); }
.locked-tab { display: flex; width: 64rpx; height: 56rpx; align-items: center; justify-content: center; border-radius: 999rpx; color: rgba(255,253,248,.84); font-size: 24rpx; font-weight: 900; }.locked-tab.active { color: #4b352e; background: #fffaf5; }
.locked-preview-image { position: absolute; inset: 0; overflow: hidden; background: #4d3932; }.locked-preview-image image { width: 100%; height: 100%; }.locked-preview-image::after { position: absolute; inset: 0; content: ""; background: linear-gradient(180deg,rgba(24,16,13,.12) 35%,rgba(24,16,13,.66) 100%); }
.locked-watermark { position: absolute; top: 42%; left: -20%; z-index: 2; width: 140%; color: rgba(255,253,248,.72); font-family: Georgia,serif; font-size: 64rpx; font-weight: 800; letter-spacing: 10rpx; text-align: center; transform: rotate(-24deg); }.locked-watermark.secondary { top: 61%; color: rgba(255,253,248,.35); font-size: 42rpx; }
.locked-sheet { position: absolute; right: 0; bottom: 0; left: 0; z-index: 5; padding: 30rpx 36rpx calc(48rpx + env(safe-area-inset-bottom)); border-radius: 56rpx 56rpx 0 0; background: #fffdf9; box-shadow: 0 -20rpx 64rpx rgba(20,12,9,.28); }.locked-sheet .sheet-title { font-size: 50rpx; }.locked-details { display: grid; gap: 14rpx; margin: 28rpx 0; }.locked-details view { padding: 18rpx 22rpx; border-radius: 22rpx; color: #9c8d84; background: #f5eee9; font-size: 24rpx; font-weight: 800; }
.report-feedback { position: fixed; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 28rpx; z-index: 50; }
.report-viewport { position: relative; height: 100vh; min-height: 1000rpx; overflow: hidden; background: #ded4cd; }
.comparison-stage { position: absolute; inset: 0; z-index: 1; overflow: hidden; background: #ded4cd; transition: height .28s cubic-bezier(.2,.82,.22,1); }
.comparison-stage::after { position: absolute; right: 0; bottom: 0; left: 0; height: 440rpx; content: ""; background: linear-gradient(transparent, rgba(29,20,17,.52)); pointer-events: none; }
.comparison-image { position: absolute; inset: 0; width: 100%; overflow: hidden; background: #ded4cd; }.comparison-image image { width: 100%; height: 100%; }.comparison-placeholder { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: #695c54; background: #e9dfd8; font-size: 24rpx; font-weight: 700; }
.comparison-image text { position: absolute; bottom: 212rpx; z-index: 3; padding: 10rpx 18rpx; border: 1rpx solid rgba(255,253,248,.34); border-radius: 999rpx; color: #fffdf8; background: rgba(33,26,22,.24); font-family: Georgia,serif; font-size: 20rpx; letter-spacing: 1rpx; }.comparison-image.original text { left: 30rpx; }.comparison-image.result text { right: 30rpx; }
.photo-topbar { position: absolute; top: calc(env(safe-area-inset-top) + 24rpx); right: 32rpx; left: 32rpx; z-index: 12; display: flex; align-items: center; justify-content: space-between; }.photo-icon { display: flex; width: 84rpx; height: 84rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(255,253,248,.42); border-radius: 50%; background: rgba(31,23,19,.16); }.photo-icon .icon-image { filter: brightness(0) invert(1); }.photo-brand { color: #fffdf8; font-family: Georgia,serif; font-size: 32rpx; font-weight: 700; letter-spacing: 3rpx; text-shadow: 0 6rpx 18rpx rgba(0,0,0,.28); }
.photo-tabs { position: absolute; top: calc(env(safe-area-inset-top) + 128rpx); left: 50%; z-index: 12; display: flex; gap: 8rpx; padding: 8rpx; border: 1rpx solid rgba(255,253,248,.25); border-radius: 999rpx; background: rgba(38,27,23,.32); transform: translateX(-50%); }.photo-tab { display: flex; width: 66rpx; height: 56rpx; align-items: center; justify-content: center; gap: 7rpx; border-radius: 999rpx; color: rgba(255,253,248,.86); font-size: 22rpx; font-weight: 800; }.photo-tab.active { color: #49342d; background: #fffaf5; box-shadow: 0 6rpx 18rpx rgba(0,0,0,.18); }.tab-dot { width: 16rpx; height: 16rpx; border: 3rpx solid rgba(255,253,248,.72); border-radius: 50%; box-sizing: border-box; }
.comparison-hint { position: absolute; top: 232rpx; left: 50%; z-index: 9; padding: 10rpx 18rpx; border-radius: 999rpx; color: rgba(255,253,248,.9); background: rgba(35,26,22,.24); font-size: 20rpx; font-weight: 700; transform: translateX(-50%); }.comparison-divider { position: absolute; top: 0; bottom: 0; z-index: 10; width: 2rpx; background: rgba(255,253,248,.9); box-shadow: 0 0 14rpx rgba(33,26,22,.18); transform: translateX(-1rpx); }.drag-handle { position: absolute; top: 47%; left: 50%; display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 2rpx solid rgba(255,253,248,.9); border-radius: 50%; background: rgba(255,250,245,.94); box-shadow: 0 12rpx 26rpx rgba(25,17,14,.22); transform: translate(-50%,-50%); }.drag-handle::before { width: 4rpx; height: 20rpx; content: ""; border-radius: 99rpx; background: #9c6861; box-shadow: 12rpx 0 0 #9c6861; transform: translateX(-6rpx); }
.report-sheet { position: absolute; right: 0; bottom: 0; left: 0; z-index: 20; height: 900rpx; box-sizing: border-box; padding: 30rpx 36rpx 150rpx; border-top: 1rpx solid rgba(255,255,255,.9); border-radius: 56rpx 56rpx 0 0; background: #fffdf9; box-shadow: 0 -20rpx 64rpx rgba(58,40,32,.2); transition: height .28s cubic-bezier(.2,.82,.22,1), transform .28s cubic-bezier(.2,.82,.22,1), border-radius .2s ease, box-shadow .2s ease; }.sheet-grabber { width: 68rpx; height: 8rpx; margin: 0 auto 30rpx; border-radius: 99rpx; background: #ddc9bf; }.sheet-eyebrow { color: #a26d62; font-family: Georgia,serif; font-size: 20rpx; letter-spacing: 2rpx; }.sheet-title { margin-top: 12rpx; color: #2e211d; font-size: 50rpx; font-weight: 900; line-height: 1.14; }.sheet-copy { margin: 14rpx 0 30rpx; color: #86766d; font-size: 25rpx; font-weight: 700; line-height: 1.55; }
.identity-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 26rpx; padding: 22rpx 0; border-top: 1rpx solid #eee3dd; border-bottom: 1rpx solid #eee3dd; }.identity-row > view + view { padding-left: 28rpx; border-left: 1rpx solid #eee3dd; }.detail-label { color: #a26d62; font-family: Georgia,serif; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }.identity-value { margin-top: 8rpx; color: #342620; font-size: 29rpx; font-weight: 900; }
.color-summary { display: grid; grid-template-columns: 136rpx 1fr; gap: 26rpx; align-items: center; padding: 26rpx; border: 1rpx solid #eadbd3; border-radius: 36rpx; background: #fcf7f3; }.color-orb { width: 124rpx; height: 124rpx; border: 10rpx solid #fffdf9; border-radius: 50%; box-sizing: border-box; box-shadow: 0 12rpx 30rpx rgba(112,57,64,.18), inset 0 0 0 1rpx rgba(60,36,31,.08); }.color-title { margin-top: 8rpx; color: #342620; font-size: 32rpx; font-weight: 900; }.color-english { margin-top: 6rpx; color: #a26d62; font-family: Georgia,serif; font-size: 19rpx; letter-spacing: 2rpx; }
.report-detail { margin-top: 18rpx; padding: 26rpx 28rpx; border-radius: 30rpx; background: #f9f3ee; }.detail-text { margin-top: 10rpx; color: #5f4f47; font-size: 25rpx; font-weight: 700; line-height: 1.6; }.report-action { height: 88rpx; margin-top: 24rpx; border-radius: 999rpx; line-height: 1; }.report-sheet .primary-button { background: #8f5954; box-shadow: 0 14rpx 32rpx rgba(122,70,68,.22); }.report-sheet .ghost-button { color: #805e55; border-color: #e2cec5; background: transparent; }.collapse-hint { margin: 26rpx 0; color: #a26d62; text-align: center; font-size: 21rpx; }
.expanded .comparison-stage { inset: 0 0 auto; height: 340rpx; }.expanded .report-sheet { height: calc(100vh - 260rpx); }.state-copy { margin-top: 200rpx; color: #8c6a5a; text-align: center; font-size: 28rpx; }
.report-sheet { padding: 26rpx 30rpx calc(120rpx + env(safe-area-inset-bottom)); }.report-sheet .sheet-grabber { margin-bottom: 22rpx; }
.expanded-tryon { display: none; overflow: hidden; background: #ebe2dc; }.expanded-tryon image { width: 100%; height: 100%; }.expanded-tryon-empty { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: #765f56; font-size: 22rpx; font-weight: 700; }
.product-hero { height: 410rpx; margin-right: -30rpx; margin-left: -30rpx; overflow: hidden; background: #ead8c3; }.product-hero image { width: 100%; height: 100%; }.product-image-empty { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: #866d5f; font-size: 23rpx; font-weight: 700; }
.product-pagination { display: flex; height: 44rpx; align-items: center; justify-content: center; gap: 10rpx; }.product-dot { width: 9rpx; height: 9rpx; border-radius: 99rpx; background: #cfc2b9; }.product-dot.active { width: 30rpx; background: #3c2d27; }
.product-title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; padding: 12rpx 0 16rpx; }.product-name { margin-top: 8rpx; color: #2c211d; font-size: 48rpx; font-weight: 900; line-height: 1.08; }.product-code { flex: 0 0 auto; padding-bottom: 3rpx; color: #382923; font-family: Georgia,serif; font-size: 32rpx; font-weight: 700; }.product-subtitle { overflow: hidden; padding-bottom: 30rpx; color: #87766c; font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.detail-tabs { display: flex; border-bottom: 1rpx solid #dfd0c5; }.detail-tab { position: relative; flex: 1; min-height: 72rpx; display: flex; align-items: center; justify-content: center; color: #8a7d74; font-size: 24rpx; font-weight: 800; }.detail-tab.active { color: #31231e; }.detail-tab.active::after { position: absolute; right: 18rpx; bottom: -1rpx; left: 18rpx; height: 3rpx; content: ""; border-radius: 99rpx; background: #48322a; }
.product-copy { min-height: 238rpx; padding: 30rpx 2rpx 8rpx; }.copy-color-line { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }.copy-heading { color: #34251f; font-size: 29rpx; font-weight: 900; }.copy-english { margin-top: 6rpx; color: #a26d62; font-family: Georgia,serif; font-size: 19rpx; letter-spacing: 1rpx; }.copy-body { color: #55443c; font-size: 26rpx; font-weight: 600; line-height: 1.7; white-space: pre-wrap; }.copy-note { margin-top: 18rpx; color: #9a867b; font-size: 23rpx; font-weight: 600; line-height: 1.6; }.product-actions { padding-top: 10rpx; }
.sheet-peek-summary { padding-bottom: 12rpx; }.expanded-report-content { display: none; }.expanded .sheet-peek-summary { display: none; }.expanded .expanded-report-content { display: block; }.expanded .report-sheet { top: auto; bottom: 0; height: calc(100vh - 248rpx); padding: 30rpx 30rpx calc(108rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(255,255,255,.9); border-radius: 48rpx 48rpx 0 0; box-shadow: 0 -20rpx 64rpx rgba(58,40,32,.2); }.expanded .report-sheet .sheet-grabber { display: block; }.expanded .product-hero { height: 420rpx; }.expanded .comparison-stage { height: 280rpx; opacity: 1; pointer-events: none; }.expanded .comparison-image text, .expanded .comparison-hint { display: none; }
.expanded .sheet-handle { position: sticky; top: 0; z-index: 4; margin: -30rpx -30rpx 0; padding: 30rpx 30rpx 14rpx; background: #fffdf9; }
.sheet-dragging .comparison-stage { opacity: 1; transition: none; }.sheet-dragging .comparison-image image { height: 100vh; }
.color-summary { animation: report-info-breathe 3.8s ease-in-out .15s infinite; }.report-detail:nth-of-type(1) { animation: report-info-breathe 3.5s ease-in-out .3s infinite; }.report-detail:nth-of-type(2) { animation: report-info-breathe 3.9s ease-in-out .55s infinite; }.report-detail:nth-of-type(3) { animation: report-info-breathe 3.6s ease-in-out .8s infinite; }
@keyframes report-info-breathe { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14rpx); } }
@media (prefers-reduced-motion: reduce) { .comparison-stage, .report-sheet { transition: none; } }

/* Product detail treatment: one continuous paper surface, matching the reference. */
.expanded .report-sheet {
  background: #fffdf9;
  border-top: 0;
  box-shadow: none;
}
.expanded .sheet-handle {
  background: #fffdf9;
}
.expanded .expanded-report-content {
  background: #fffdf9;
}
.expanded .product-hero {
  height: 460rpx;
  margin-right: -30rpx;
  margin-left: -30rpx;
  border-radius: 0;
  background: #fffdf9;
  box-shadow: none;
}
.expanded .product-hero-empty {
  height: 180rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(122, 93, 76, .18);
  background: rgba(255, 253, 249, .34);
}
.expanded .product-hero-empty .product-image-empty {
  color: #a58f83;
  font-size: 23rpx;
  font-weight: 600;
}
.expanded .product-hero:not(.product-hero-empty) {
  border: 0;
  background: transparent;
}
.expanded .product-hero image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 0;
}
.expanded .product-pagination {
  background: #fffdf9;
}
.expanded .product-title-row,
.expanded .product-subtitle,
.expanded .detail-tabs,
.expanded .product-copy,
.expanded .product-actions,
.expanded .collapse-hint {
  background: #fffdf9;
}
.expanded .product-title-row {
  padding-top: 26rpx;
}
.expanded .detail-tabs {
  border-bottom-color: rgba(92, 65, 43, .28);
}
.expanded .product-copy {
  min-height: 260rpx;
}

.locked-watermark {
  top: 40%;
  color: rgba(255,253,248,.62);
  font-size: 50rpx;
  text-shadow: 0 1rpx 6rpx rgba(58, 35, 30, .18);
}

.locked-watermark.secondary {
  top: 56%;
  color: rgba(255,253,248,.56);
  font-size: 46rpx;
}

.locked-watermark.tertiary {
  top: 64%;
  color: rgba(255,253,248,.48);
  font-size: 42rpx;
}

.locked-watermark.upper {
  top: 32%;
  left: -20%;
  color: rgba(255,253,248,.44);
  font-size: 38rpx;
}

.locked-watermark.mid {
  top: 48%;
  left: -20%;
  color: rgba(255,253,248,.54);
  font-size: 40rpx;
}

.locked-sheet {
  height: 500rpx;
  box-sizing: border-box;
  overflow: hidden;
  transition: height .28s cubic-bezier(.2,.82,.22,1), transform .2s ease-out;
}

.locked-sheet.is-dragging {
  transition: none;
}

.locked-sheet.expanded {
  height: calc(100vh - 230rpx);
}

.locked-sheet .locked-details {
  display: none;
}

.locked-sheet.expanded .locked-details {
  display: grid;
}

.locked-sheet .sheet-eyebrow {
  font-size: 24rpx;
}

.locked-sheet .sheet-title {
  font-size: 60rpx;
}

.locked-sheet .sheet-copy {
  font-size: 28rpx;
}

.locked-sheet .locked-details view {
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}

.locked-preview-image::after {
  background: transparent;
}

.locked-sheet {
  box-shadow: none;
}

.locked-sheet.peek {
  height: 390rpx;
  padding-top: 24rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.locked-sheet.peek .sheet-grabber {
  margin-bottom: 16rpx;
}

.locked-sheet.peek .sheet-title {
  font-size: 54rpx;
}

.locked-sheet.peek .sheet-copy {
  margin: 8rpx 0 14rpx;
  font-size: 26rpx;
}

.expanded .product-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 260rpx;
  padding: 0 0 32rpx;
}

.expanded .product-actions .report-action {
  width: 340rpx;
  height: 76rpx;
  min-height: 76rpx;
  margin-top: 0;
  font-size: 24rpx;
  line-height: 1;
}

.expanded .product-actions {
  position: relative;
  width: 340rpx;
  height: 76rpx;
  flex-direction: row;
  justify-content: center;
  gap: 0;
  margin: 260rpx auto 32rpx;
  padding: 0;
}

.delete-original-icon {
  position: absolute;
  top: 4rpx;
  left: 352rpx;
  display: flex;
  width: 68rpx;
  height: 68rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e6d1c8;
  border-radius: 50%;
  color: #9b6962;
  background: #f8ebe5;
  box-shadow: 0 8rpx 18rpx rgba(122,70,68,.08);
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
}

.product-color-swatch { width: 76rpx; height: 76rpx; flex: 0 0 76rpx; border: 6rpx solid #fffdf9; border-radius: 50%; box-sizing: border-box; box-shadow: 0 8rpx 20rpx rgba(78,45,36,.14), inset 0 0 0 1rpx rgba(60,36,31,.08); }
.product-title-row .product-color-swatch { margin-bottom: 6rpx; }
.copy-color-swatch { width: 64rpx; height: 64rpx; flex-basis: 64rpx; }
