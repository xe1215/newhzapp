<view class="page flow-page payment-page">
  <view class="flow-head"><view class="back-icon pressable" aria-label="返回" bindtap="goBack" hover-class="pressable-hover"><image class="icon-image" src="../../images/ui/back.svg" mode="aspectFit"/></view><view class="eyebrow">NewHz / UNLOCK</view></view>
  <view class="title">解锁完整试色报告</view>
  <view class="copy">包含高清无水印试色图、品牌色号、颜色分析和搭配建议。</view>
  <view class="surface payment-card">
    <view class="price">¥5.99</view>
    <view class="payment-note">当前试色组 · 支付后立即查看</view>
  </view>
  <label class="retention-consent"><checkbox value="retain" checked="{{retainOriginalConsent}}" bindchange="onRetentionConsentChange" color="#8f5954"/>我同意为展示付费报告中的 Before / After 对比保存原图，可随时在报告中删除。</label>
  <view wx:if="{{paymentStatus === 'paid'}}" class="success-note">支付已确认，完整报告已经准备好。</view>
  <view wx:if="{{feedback}}" class="feedback">{{feedback}}</view>
  <button class="primary-button" loading="{{confirming}}" bindtap="confirmUnlock">确认支付</button>
  <button class="secondary-button" bindtap="viewReport" disabled="{{!canViewReport}}">查看完整报告</button>
  <button class="ghost-button" bindtap="openRefundHelp">退款说明</button>
</view>
