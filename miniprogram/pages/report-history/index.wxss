@import "../shared.wxss";
.history-page { min-height: 100vh; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }.history-list { display: grid; gap: 20rpx; margin-top: 44rpx; }.history-row { display: flex; min-height: 174rpx; align-items: center; gap: 24rpx; padding: 16rpx; border: 1rpx solid #ead8d0; border-radius: 28rpx; background: rgba(255,253,249,.9); box-shadow: 0 18rpx 42rpx rgba(67,45,34,.08); }.history-cover { width: 142rpx; height: 142rpx; flex: 0 0 142rpx; overflow: hidden; border-radius: 20rpx; background: #e5d7d0; }.history-cover-empty { display: flex; align-items: center; justify-content: center; color: #76564d; font-family: Georgia,serif; font-size: 25rpx; font-weight: 800; }.history-copy { min-width: 0; flex: 1; }.history-title { overflow: hidden; margin-top: 9rpx; color: #34241f; font-size: 31rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.history-meta { overflow: hidden; margin-top: 8rpx; color: #7d6c63; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.history-status { margin-top: 12rpx; color: #a26d62; font-size: 21rpx; font-weight: 800; }.history-arrow { width: 30rpx; height: 30rpx; opacity: .55; }.history-state { margin-top: 180rpx; color: #84766f; text-align: center; }.history-retry { margin-top: 22rpx; color: #9f5d59; font-size: 26rpx; font-weight: 900; }.history-empty { margin-top: 120rpx; padding: 48rpx; border: 1rpx solid #ead8d0; border-radius: 32rpx; background: rgba(255,253,249,.78); }.history-empty .brand-copy { margin-top: 12rpx; }
