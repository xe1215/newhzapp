<view class="page history-page">
  <view class="top-row"><view class="brand"><view class="brand-title">NewHz</view><view class="brand-sub">我的报告</view><view class="brand-copy">每一份已解锁报告都保存在这里。</view></view><view class="round-icon pressable" bindtap="goBack" aria-label="返回我的" hover-class="pressable-hover"><image class="icon-image" src="../../images/ui/back.svg" mode="aspectFit"/></view></view>
  <view wx:if="{{loading}}" class="history-state">正在加载报告...</view><view wx:elif="{{errorText}}" class="history-state">{{errorText}}<view class="history-retry pressable" bindtap="loadReports" hover-class="pressable-hover">重新加载</view></view>
  <view wx:elif="{{!reports.length}}" class="history-empty"><view class="brand-sub">还没有已解锁报告</view><view class="brand-copy">完成试色并解锁后，报告会保存在这里。</view></view>
  <view wx:else class="history-list"><view wx:for="{{reports}}" wx:key="reportId" class="history-row pressable" data-test-id="{{item.testId}}" data-report-id="{{item.reportId}}" bindtap="openReport" hover-class="pressable-hover"><image wx:if="{{item.coverUrl}}" class="history-cover" src="{{item.coverUrl}}" mode="aspectFill"/><view wx:else class="history-cover history-cover-empty">NewHz</view><view class="history-copy"><view class="micro">{{item.displayDate}}</view><view class="history-title">{{item.shadeName || '专属试色报告'}}</view><view class="history-meta">{{item.brand || 'NewHz'}} {{item.shadeCode || ''}}</view><view class="history-status">已解锁 · 3 支推荐</view></view><image class="history-arrow" src="../../images/ui/arrow-right.svg" mode="aspectFit"/></view></view>
</view>
