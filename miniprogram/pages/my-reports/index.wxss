@import "../shared.wxss";
.reports-page { overflow: hidden; }.icon-buttons { display: flex; gap: 20rpx; }.page-dark .round-icon { color: #f1c6ba; background: rgba(255,253,248,.07); border-color: rgba(241,198,186,.18); }
.report-stack { position: relative; height: 910rpx; margin-top: 56rpx; }
.report-cover { position: absolute; right: 0; left: 0; height: 376rpx; overflow: hidden; border: 1rpx solid rgba(241,198,186,.16); border-radius: 40rpx; background: linear-gradient(145deg,#e6c6bd,#ad7b6c 42%,#2c211b); box-shadow: 0 44rpx 110rpx rgba(0,0,0,.42); animation: cardIn .85s ease both; transition: transform .28s cubic-bezier(.2,.85,.25,1), opacity .22s ease; }
.report-cover:nth-child(1) { top: 0; z-index: 4; }.report-cover:nth-child(2) { top: 156rpx; right: -28rpx; left: 52rpx; z-index: 3; opacity: .85; }.report-cover:nth-child(3) { top: 312rpx; right: 56rpx; left: -20rpx; z-index: 2; opacity: .78; }
.deck-next .report-cover:nth-child(1) { transform: translateX(-48rpx) rotate(-4deg) scale(.94); opacity: 0; }.deck-prev .report-cover:nth-child(1) { transform: translateX(48rpx) rotate(4deg) scale(.94); opacity: 0; }
.report-photo { position: absolute; width: 100%; height: 100%; }.report-shade { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(0,0,0,.5),rgba(0,0,0,.14) 48%,transparent); }
.report-image-unavailable { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(255,253,248,.72); background: #4a3b35; font-size: 24rpx; font-weight: 800; }
.reports-page { background: #1e1714; }.report-cover { border-color: rgba(245,212,202,.24); box-shadow: 0 36rpx 90rpx rgba(0,0,0,.38); }.style-tags text { background: rgba(255,253,248,.2); }.chipline { background: rgba(202,139,126,.22); }
.deck-next .report-cover:nth-child(2) { transform: translate(-36rpx,-104rpx) rotate(-1.5deg) scale(.98); }.deck-prev .report-cover:nth-child(2) { transform: translate(28rpx,-104rpx) rotate(1.5deg) scale(.98); }.deck-next .report-cover:nth-child(3), .deck-prev .report-cover:nth-child(3) { transform: translateY(-78rpx) scale(.94); }
.report-cover:nth-child(1) { animation: cardIn .85s ease both, report-card-breathe-a 3.8s ease-in-out .9s infinite; }.report-cover:nth-child(2) { animation: cardIn .85s .08s ease both, report-card-breathe-b 3.5s ease-in-out 1.02s infinite; }.report-cover:nth-child(3) { animation: cardIn .85s .16s ease both, report-card-breathe-c 3.9s ease-in-out 1.14s infinite; }
@keyframes report-card-breathe-a { 0%,100% { top: 0; } 50% { top: -14rpx; } }
@keyframes report-card-breathe-b { 0%,100% { top: 156rpx; } 50% { top: 142rpx; } }
@keyframes report-card-breathe-c { 0%,100% { top: 312rpx; } 50% { top: 298rpx; } }
.report-card-flow { width: auto; height: 498rpx; margin-right: -40rpx; margin-left: -40rpx; padding-left: 40rpx; overflow: visible; }.report-flow-row { display: flex; width: max-content; padding-right: 120rpx; }.report-card-flow .report-cover { position: relative; top: auto !important; right: auto !important; left: auto !important; width: 600rpx; height: 420rpx; flex: 0 0 600rpx; margin-left: -170rpx; border-radius: 42rpx; opacity: 1; animation: none !important; transition: transform .26s cubic-bezier(.2,.82,.22,1), filter .26s ease; }.report-card-flow .report-cover:first-child { z-index: 3; margin-left: 0; transform: translateY(0) !important; }.report-card-flow .report-cover:nth-child(2) { z-index: 2; transform: translateY(38rpx) !important; }.report-card-flow .report-cover:nth-child(3) { z-index: 1; transform: translateY(76rpx) !important; }.report-card-flow .report-cover:not(:first-child) { filter: saturate(.76) brightness(.84); }.report-card-flow .report-name { font-size: 46rpx; }.report-card-flow .style-tags { top: 178rpx; }.report-card-flow .chipline { top: 288rpx; white-space: nowrap; }
.report-card-flow .report-cover.flow-active { z-index: 6; filter: none; transform: translateY(0) !important; }
.report-inside { position: relative; z-index: 2; padding: 40rpx 44rpx; }.report-name { margin-top: 16rpx; color: #fffdf8; font-size: 54rpx; font-weight: 900; line-height: 1; }
.style-tags { position: absolute; top: 164rpx; left: 44rpx; z-index: 2; display: flex; gap: 14rpx; }.style-tags text { padding: 14rpx 20rpx; border: 1rpx solid rgba(255,253,248,.18); border-radius: 999rpx; color: #fffdf8; background: rgba(255,253,248,.28); font-size: 22rpx; font-weight: 900; }
.chipline { position: absolute; top: 260rpx; left: 48rpx; z-index: 2; padding: 16rpx 24rpx; border-radius: 999rpx; color: rgba(255,253,248,.88); background: rgba(255,253,248,.16); font-size: 22rpx; font-weight: 800; }
.state-copy { margin-top: 160rpx; color: rgba(255,253,248,.58); text-align: center; }.empty-state { margin-top: 100rpx; padding: 48rpx; border: 1rpx solid rgba(241,198,186,.16); border-radius: 40rpx; background: #211a16; }.empty-state .brand-sub { margin-top: 0; }
.report-footer-actions { display: flex; gap: 16rpx; margin-top: 12rpx; padding-bottom: 172rpx; }.text-action { flex: 1; min-height: 84rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(241,198,186,.22); border-radius: 999rpx; color: rgba(255,246,241,.82); font-size: 24rpx; font-weight: 800; }

/* Fixed, three-layer report stack: the back cards are visible as deliberate paper edges. */
.report-card-flow { position: relative; height: 640rpx; margin-right: 0; margin-left: 0; padding-left: 0; overflow: visible; }
.report-card-flow .report-flow-row { position: relative; display: block; width: 100%; height: 100%; padding-right: 0; }
.report-card-flow .report-flow-row { transition: transform 320ms cubic-bezier(.18,.82,.22,1); }
.report-card-flow .report-flow-row.is-dragging { transition: none; }
.report-card-flow .report-cover { position: absolute; top: 0 !important; right: auto !important; left: 0 !important; width: 100%; height: 420rpx; margin-left: 0; opacity: 1; transform-origin: center top; transition: transform 300ms cubic-bezier(.22,.8,.25,1), filter 220ms ease, opacity 220ms ease; }
.report-card-flow .report-cover.stack-front { z-index: 3; filter: none; transform: translate3d(0,0,0) scale(1) !important; }
.report-card-flow .report-cover.stack-middle { z-index: 2; filter: saturate(.8) brightness(.88); transform: translate3d(20rpx,96rpx,0) scale(.985) !important; }
.report-card-flow .report-cover.stack-back { z-index: 1; filter: saturate(.68) brightness(.78); transform: translate3d(-8rpx,188rpx,0) scale(.97) !important; }
.report-card-flow.deck-snap .report-flow-row { animation: stack-settle 300ms cubic-bezier(.22,.8,.25,1); }
.report-card-flow.deck-edge-left .report-flow-row { animation: edge-left 260ms ease-out; }
.report-card-flow.deck-edge-right .report-flow-row { animation: edge-right 260ms ease-out; }
.report-card-flow .report-flow-row.is-dragging .report-cover.stack-middle { transform: translate3d(20rpx,68rpx,0) scale(1.02) !important; filter: saturate(.9) brightness(.93); }
.report-card-flow.deck-exit-left .report-cover.stack-front { opacity: 0; box-shadow: -72rpx 112rpx 78rpx rgba(0,0,0,.55); transform: translate3d(-430rpx,180rpx,0) rotate(-14deg) scale(.94) !important; transition: transform 300ms cubic-bezier(.55,.02,.86,.35), opacity 260ms ease-in, box-shadow 300ms ease-in; }
.report-card-flow.deck-exit-right .report-cover.stack-front { opacity: 0; box-shadow: 72rpx 112rpx 78rpx rgba(0,0,0,.55); transform: translate3d(430rpx,180rpx,0) rotate(14deg) scale(.94) !important; transition: transform 300ms cubic-bezier(.55,.02,.86,.35), opacity 260ms ease-in, box-shadow 300ms ease-in; }
.report-card-flow.deck-enter-from-right .report-cover.stack-front { opacity: 0; transform: translate3d(240rpx,-104rpx,0) rotate(12deg) scale(.95) !important; }
.report-card-flow.deck-enter-from-left .report-cover.stack-front { opacity: 0; transform: translate3d(-240rpx,-104rpx,0) rotate(-12deg) scale(.95) !important; }
.report-card-flow.deck-settle .report-cover.stack-front { animation: report-deck-card-settle 380ms cubic-bezier(.18,.85,.28,1.22) both; }
@keyframes report-deck-card-settle { 0% { transform: translate3d(18rpx,-8rpx,0) rotate(2deg) scale(.98); } 62% { transform: translate3d(-5rpx,2rpx,0) rotate(-.8deg) scale(1.008); } 100% { transform: translate3d(0,0,0) rotate(0) scale(1); } }

/* Match the reference's smooth horizontal ticket stream while preserving the report pile. */
.report-card-flow.deck-exit-left .report-cover.stack-front { opacity: 0; box-shadow: -104rpx 26rpx 78rpx rgba(0,0,0,.42); transform: translate3d(-800rpx,0,0) rotate(-1.2deg) scale(.99) !important; transition: transform 300ms cubic-bezier(.48,0,.86,.35), opacity 250ms ease-in, box-shadow 300ms ease-in; }
.report-card-flow.deck-exit-right .report-cover.stack-front { opacity: 0; box-shadow: 104rpx 26rpx 78rpx rgba(0,0,0,.42); transform: translate3d(800rpx,0,0) rotate(1.2deg) scale(.99) !important; transition: transform 300ms cubic-bezier(.48,0,.86,.35), opacity 250ms ease-in, box-shadow 300ms ease-in; }
.report-card-flow.deck-exit-left .report-cover.stack-middle,
.report-card-flow.deck-exit-right .report-cover.stack-middle { transform: translate3d(14rpx,72rpx,0) scale(1.005) !important; }
.report-card-flow.deck-enter-from-right .report-cover.stack-front { opacity: 0; transform: translate3d(740rpx,-8rpx,0) rotate(1deg) scale(.99) !important; }
.report-card-flow.deck-enter-from-left .report-cover.stack-front { opacity: 0; transform: translate3d(-740rpx,-8rpx,0) rotate(-1deg) scale(.99) !important; }
.report-card-flow.deck-settle .report-cover.stack-front { animation: none; }
