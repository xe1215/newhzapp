<view class="page flow-page">
  <view class="eyebrow">NewHz / PREFERENCES</view>
  <view class="title">告诉我你想要的感觉。</view>
  <view class="copy">你的偏好会影响推荐的色调、质地和使用场景。</view>

  <view class="preference-group"><view class="section-title">肤色</view><view class="chip-row"><button wx:for="{{options.skinTone}}" wx:key="value" class="choice-chip {{skinTone === item.value ? 'choice-active' : ''}}" data-field="skinTone" data-value="{{item.value}}" bindtap="selectOption">{{item.label}}</button></view></view>
  <view class="preference-group"><view class="section-title">预算</view><view class="chip-row"><button wx:for="{{options.budget}}" wx:key="value" class="choice-chip {{budget === item.value ? 'choice-active' : ''}}" data-field="budget" data-value="{{item.value}}" bindtap="selectOption">{{item.label}}</button></view></view>
  <view class="preference-group"><view class="section-title">场景</view><view class="chip-row"><button wx:for="{{options.scene}}" wx:key="value" class="choice-chip {{scene === item.value ? 'choice-active' : ''}}" data-field="scene" data-value="{{item.value}}" bindtap="selectOption">{{item.label}}</button></view></view>
  <view class="preference-group"><view class="section-title">风格</view><view class="chip-row"><button wx:for="{{options.style}}" wx:key="value" class="choice-chip {{style === item.value ? 'choice-active' : ''}}" data-field="style" data-value="{{item.value}}" bindtap="selectOption">{{item.label}}</button></view></view>

  <button class="primary-button submit-button" bindtap="startGenerating" loading="{{submitting}}" disabled="{{submitting}}">生成我的试色</button>
  <view wx:if="{{feedback}}" class="feedback">{{feedback}}</view>
</view>
