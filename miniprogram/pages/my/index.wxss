@import "../shared.wxss";
.icon-buttons { display: flex; gap: 20rpx; }
.profile-card { display: flex; align-items: center; gap: 28rpx; margin-top: 36rpx; padding: 44rpx; border: 1rpx solid rgba(85,65,52,.16); border-radius: 52rpx; background: rgba(255,253,248,.72); box-shadow: 0 36rpx 96rpx rgba(58,45,36,.16); animation: rise .75s .1s ease both; }
.avatar { width: 116rpx; height: 116rpx; border-radius: 50%; background: linear-gradient(135deg,#f1c6ba,#8c6a5a); box-shadow: inset 0 0 0 8rpx rgba(255,253,248,.56); }
.profile-name { font-size: 38rpx; font-weight: 900; }.profile-card .section-sub { margin-top: 6rpx; }
.menu { margin-top: 40rpx; overflow: hidden; border: 1rpx solid rgba(85,65,52,.16); border-radius: 52rpx; background: rgba(255,253,248,.72); box-shadow: 0 36rpx 96rpx rgba(58,45,36,.16); animation: rise .75s .2s ease both; }
.menu-row { display: flex; height: 116rpx; align-items: center; justify-content: space-between; padding: 0 36rpx; border-bottom: 1rpx solid rgba(105,80,64,.09); font-size: 30rpx; font-weight: 900; }.menu-row:last-child { color: #a95d58; border-bottom: 0; }
.account-note { margin-top: 36rpx; padding: 36rpx; border: 1rpx solid rgba(85,65,52,.16); border-radius: 52rpx; background: rgba(255,253,248,.72); box-shadow: 0 36rpx 96rpx rgba(58,45,36,.16); }.account-note .section-sub { margin-top: 14rpx; }
.profile-card, .menu, .account-note { border-color: #ead8d0; background: rgba(255,253,249,.9); box-shadow: 0 20rpx 54rpx rgba(67,45,34,.1); }.avatar { background: linear-gradient(135deg,#f4d9d1,#9d625b); }.menu-row { transition: background .18s ease; }.menu-row:active { background: #faf0eb; }
