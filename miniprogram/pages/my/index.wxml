<view class="page my-page">
  <view class="top-row"><view class="brand"><view class="brand-title">NewHz</view><view class="brand-sub">我的</view><view class="brand-copy">查看账号状态、已保存报告，以及退出登录入口。</view></view><view class="icon-buttons"><view class="round-icon pressable" aria-label="打开报告" bindtap="openReports" hover-class="pressable-hover"><image class="icon-image" src="../../images/ui/report.svg" mode="aspectFit"/></view><view class="round-icon pressable" aria-label="账号设置" bindtap="openAccountSettings" hover-class="pressable-hover"><image class="icon-image" src="../../images/ui/user.svg" mode="aspectFit"/></view></view></view>
  <view class="profile-card"><view class="avatar"></view><view><view class="profile-name">微信用户</view><view class="section-sub">已生成 {{reportCount}} 份试色报告</view></view></view>
  <view class="menu"><view class="menu-row pressable" bindtap="openReportHistory" hover-class="pressable-hover"><text>我的报告</text><image class="icon-image" src="../../images/ui/arrow-right.svg" mode="aspectFit"/></view><view class="menu-row pressable" bindtap="openAccountSettings" hover-class="pressable-hover"><text>账号设置</text><image class="icon-image" src="../../images/ui/arrow-right.svg" mode="aspectFit"/></view><view class="menu-row pressable" bindtap="openRefundHelp" hover-class="pressable-hover"><text>退款说明</text><image class="icon-image" src="../../images/ui/arrow-right.svg" mode="aspectFit"/></view><view class="menu-row pressable" bindtap="logout" hover-class="pressable-hover"><text>退出登录</text><image class="icon-image" src="../../images/ui/arrow-right.svg" mode="aspectFit"/></view></view>
  <view class="account-note"><view class="micro">ACCOUNT</view><view class="section-sub">这里集中管理账号、历史报告和退款帮助。</view></view><view wx:if="{{feedback}}" class="feedback">{{feedback}}</view>
  <view class="bottom-nav"><view class="nav-item pressable" bindtap="openHome" hover-class="pressable-hover"><image class="nav-icon" src="../../images/ui/home.svg" mode="aspectFit"/><text>首页</text></view><view class="nav-item pressable" bindtap="openReports" hover-class="pressable-hover"><image class="nav-icon" src="../../images/ui/report.svg" mode="aspectFit"/><text>报告</text></view><view class="nav-item active pressable" hover-class="pressable-hover"><image class="nav-icon" src="../../images/ui/user.svg" mode="aspectFit"/><text>我的</text></view></view>
</view>
