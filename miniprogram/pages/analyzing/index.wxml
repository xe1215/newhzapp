<view id="phone-analyzing" style="--status-top:{{statusBarHeight}}px" class="phone design-page"><view class="safe-top" style="height:{{statusBarHeight}}px"></view>
<view class="nav-bar">
<button bindtap="onAction" data-action="back" data-target="返回" class="back-btn">‹</button>
<view class="title">AI 分析</view>
<view class="nav-actions">
<button bindtap="onAction" data-action="showToast" data-target="更多功能" class="icon-btn">
<image src="/images/ui/reference-25.svg" mode="aspectFit" style="width:32rpx;height:32rpx" class="ui-icon"></image>
</button>
<button bindtap="onAction" data-action="showToast" data-target="个人中心" class="icon-btn">
<image src="/images/ui/reference-26.svg" mode="aspectFit" style="width:32rpx;height:32rpx" class="ui-icon"></image>
</button>
</view>
</view>
<scroll-view style="padding-top:24rpx" scroll-y="true" class="phone-content">
<view style="font-size:48rpx;font-weight:700;margin-bottom:48rpx;line-height:1.3" class="html-h2">正在分析你的
<view class="html-br"></view>
美妆画像</view>
<view style="display:flex;justify-content:center;margin-bottom:64rpx;position:relative">
<image wx:if="{{analysisImageUrl}}" src="{{analysisImageUrl}}" mode="aspectFill" style="width:360rpx;height:360rpx;border-radius:48rpx;object-fit:cover;box-shadow:0 8rpx 48rpx rgba(150, 107, 91, 0.08)" class="media"></image>
<view wx:else style="width:360rpx;height:360rpx;border-radius:48rpx;box-shadow:0 8rpx 48rpx rgba(150, 107, 91, 0.08)" class="media analysis-image-fallback">照片加载失败</view>
<view style="position:absolute;bottom:16rpx;left:50%;transform:translateX(-50%);background:rgba(255,255,255,0.9);backdrop-filter:blur(20rpx);padding:8rpx 24rpx;border-radius:16rpx;font-size:22rpx;color:#8B7B75">分析中</view>
<view style="position:absolute;top:0;left:10%;right:10%;height:4rpx;background:linear-gradient(90deg,transparent,#966B5B,transparent);animation:scan 2s ease-in-out infinite;border-radius:4rpx" class="scan-line"></view>
</view>
<view wx:if="{{failed}}" class="mock-error">分析暂未完成<button bindtap="retry" class="btn-primary brown">重新分析</button></view>
<view wx:else class="analysis-steps">
<view wx:for="{{steps}}" wx:key="name" class="analysis-step {{item.state}}">
<view class="step-icon {{item.state === 'done' ? 'check' : item.state === 'active' ? 'spinner' : 'pending'}}">
<image wx:if="{{item.state === 'done'}}" src="/images/ui/reference-27.svg" mode="aspectFit" style="width:28rpx;height:28rpx" class="ui-icon"></image>
<image wx:elif="{{item.state === 'active'}}" src="/images/ui/reference-30.svg" mode="aspectFit" style="width:28rpx;height:28rpx" class="ui-icon"></image>
</view>
<text class="step-text">{{item.name}}</text>
<text class="step-status">{{item.status}}</text>
</view>
</view>
<view style="text-align:center;margin-top:64rpx;font-size:24rpx;color:#B5A8A2">分析完成后，可确认或修改画像</view>
</scroll-view>
</view>
