.product-img { width:100%; aspect-ratio:1; }
.ui-icon { display:inline-block; flex-shrink:0; vertical-align:middle; }
.html-br { display:block; height:0; }
.tryon-page { justify-content:flex-end; }
#phone-tryon .nav-bar { top:var(--status-top); }
#phone-tryon .bottom-sheet { height:auto; flex-shrink:0; }
#phone-tryon .sheet-expanded { max-height:none; height:auto; overflow:visible; }
#phone-tryon .sheet-gallery { width:100%; }
.sheet-measure { position:absolute; left:0; right:0; top:0; visibility:hidden; pointer-events:none; }
#phone-tryon .sheet-measure .sheet-expanded { display:block; }
.sheet-scroll { height:calc(100% - 36rpx); display:none; }
.bottom-sheet.expanded .sheet-scroll { display:block; }
.ba-before-wrap,.ba-divider { pointer-events:none; }
.mock-error { padding:24rpx 40rpx; color:#966B5B; background:#FFFEFB; }
.design-page .tag-edit { width:auto; margin:0 0 0 auto; }
.design-page .link-btn { width:auto; margin:0; }
.design-page .btn-primary { margin:0; line-height:normal; }
.design-page .fit-camera-btn { padding:0; margin:0; }
#phone-tryon .bottom-sheet.expanded .sheet-expanded { max-height:none; }
#phone-tryon .sheet-measure .sheet-expanded { height:auto; padding:0 40rpx 36rpx; }
.analysis-step.active .step-status { color:#966B5B; }
.analysis-step.pending .step-status { color:#B5A8A2; }
.shade-option.selected::after { content:'✓'; position:absolute; top:-2rpx; right:-2rpx; width:36rpx; height:36rpx; border-radius:0 20rpx 0 20rpx; color:white; background:#966B5B; font-size:24rpx; display:flex; align-items:center; justify-content:center; }
/* Credit balance entry */
.credit-pill{display:flex;align-items:center;justify-content:center;gap:10rpx;width:112rpx;min-width:112rpx;max-width:112rpx;height:64rpx;padding:0;border:1rpx solid #e2d5ec;border-radius:32rpx;background:linear-gradient(180deg,#f8f3fb 0%,#eee5f7 100%);color:#69527d;font-size:24rpx;line-height:1;font-weight:700;white-space:nowrap;overflow:hidden;box-shadow:0 6rpx 16rpx rgba(113,83,132,.12)}
.credit-pill:active{background:#e8dcf1;box-shadow:0 2rpx 8rpx rgba(113,83,132,.1);transform:translateY(1rpx)}
.credit-bolt{display:inline-flex;align-items:center;justify-content:center;width:28rpx;height:28rpx;color:#8d6aa1;font-size:29rpx;line-height:1;font-weight:800}
.design-page .nav-actions-credit{visibility:visible;position:absolute;top:calc(var(--status-top) + 112rpx);right:40rpx;z-index:3}
.design-page .nav-actions-credit .icon-btn{display:none}
.search-bar-short{width:70%;}
