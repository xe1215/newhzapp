  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  z-index: 3;
}
.ba-label-left { left: 32rpx; }
.ba-label-right { right: 32rpx; }


.ba-hint {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
