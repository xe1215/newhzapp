/* Reference: D:/index_embed.html, 375px baseline; 1px = 2rpx. */


page {
  --bg: #F2EDE6;
  --card: #FFFEFB;
  --primary: #966B5B;
  --primary-dark: #7A5548;
  --primary-light: #E8D5CF;
  --primary-pale: #F5EBE7;
  --text: #3A2A25;
  --text-secondary: #8B7B75;
  --text-muted: #B5A8A2;
  --border: #EDE5DE;
  --shadow: 0 8rpx 48rpx rgba(150, 107, 91, 0.08);
  --shadow-lg: 0 16rpx 80rpx rgba(150, 107, 91, 0.12);
  --radius: 40rpx;
  --radius-sm: 24rpx;
  --phone-w: 750rpx;
  --phone-h: 1520rpx;
}

view, text, button, image, scroll-view { margin: 0; padding: 0; box-sizing: border-box; }

page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  background: #F2EDE6;
  color: #3A2A25;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  -webkit-font-smoothing: antialiased;
}


.page-header {
  width: 100%;
  max-width: 2400rpx;
  padding: 64rpx 80rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.page-header h1 {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.page-header .meta {
  font-size: 26rpx;
  color: #8B7B75;
  margin-top: 12rpx;
}
.page-header .design-tag {
  font-size: 24rpx;
  color: #B5A8A2;
  letter-spacing: 2rpx;
}


.phone-stage {
  display: flex;
  gap: 64rpx;
  padding: 80rpx;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-start;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.phone-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.phone-label {
  font-size: 26rpx;
  color: #8B7B75;
  font-weight: 500;
}
.phone-label .num {
  color: #966B5B;
  font-weight: 700;
  margin-right: 12rpx;
}

.phone {
  width: 750rpx;
  height: 1520rpx;
  background: #FFFEFB;
  border-radius: 72rpx;
  box-shadow: 0 16rpx 80rpx rgba(150, 107, 91, 0.12);
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
}


.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 48rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2A25;
  flex-shrink: 0;
}
.status-bar .icons {
  display: flex;
  gap: 10rpx;
  align-items: center;
}


.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 40rpx 24rpx;
  flex-shrink: 0;
}
.nav-bar .brand {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.nav-bar .nav-actions {
  display: flex;
  gap: 16rpx;
}
.nav-bar .icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F5EBE7;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #966B5B;
  transition: all 0.2s;
}
.nav-bar .icon-btn:hover { background: #E8D5CF; }
.nav-bar .back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #3A2A25;
  font-size: 40rpx;
  transition: all 0.2s;
}
.nav-bar .back-btn:hover { background: #F5EBE7; }
.nav-bar .title {
  font-size: 34rpx;
  font-weight: 600;
  flex: 1;
  text-align: center;
  margin-right: 64rpx;
}


.phone-content {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 40rpx;
  scrollbar-width: none;
}
.phone-content::-webkit-scrollbar { display: none; }

.discover-toolbar { flex-shrink: 0; padding: 0 40rpx; background: #FFFEFB; }


.bottom-nav {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 32rpx 40rpx;
  background: #FFFEFB;
  border-top: 2rpx solid #EDE5DE;
  flex-shrink: 0;
}
.bottom-nav .nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  cursor: pointer;
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
  transition: all 0.2s;
  color: #B5A8A2;
  font-size: 22rpx;
  font-weight: 500;
}
.bottom-nav .nav-item.active {
  background: #966B5B;
  color: white;
}
.bottom-nav .nav-item .ui-icon { width: 40rpx; height: 40rpx; }


.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F5EBE7;
  border-radius: 28rpx;
  padding: 22rpx 32rpx;
  margin-bottom: 36rpx;
  cursor: pointer;
  transition: all 0.2s;
}
.search-bar:hover { background: #E8D5CF; }
.search-bar .ui-icon { width: 32rpx; height: 32rpx; color: #8B7B75; flex-shrink: 0; }
.search-bar text { font-size: 26rpx; color: #B5A8A2; }

.category-tabs {
  display: flex;
  gap: 36rpx;
  margin-bottom: 36rpx;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 4rpx;
}
.category-tabs::-webkit-scrollbar { display: none; }
.category-tab {
  font-size: 26rpx;
  color: #8B7B75;
  cursor: pointer;
  white-space: nowrap;
  padding-bottom: 8rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
  font-weight: 500;
}
.category-tab.active {
  color: #3A2A25;
  font-weight: 700;
  border-bottom-color: #966B5B;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding-bottom: 32rpx;
}
.product-card {
  background: #FFFEFB;
  border-radius: 32rpx;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
  border: 2rpx solid #EDE5DE;
}
.product-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 48rpx rgba(150, 107, 91, 0.08);
}
.product-card .product-img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  display: block;
}
.product-card .product-info {
  padding: 20rpx 24rpx 24rpx;
}
.product-card .brand-name {
  font-size: 22rpx;
  color: #8B7B75;
  margin-bottom: 4rpx;
}
.product-card .product-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.3;
}
.product-card .color-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #8B7B75;
  margin-bottom: 12rpx;
}
.product-card .color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.product-card .price {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A2A25;
}


.fit-header {
  margin-bottom: 48rpx;
}
.fit-header .html-h2 {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  line-height: 1.3;
}
.fit-header .html-p {
  font-size: 26rpx;
  color: #8B7B75;
  line-height: 1.6;
}

.fit-photo-area {
  display: flex;
  justify-content: center;
  margin-bottom: 56rpx;
  position: relative;
}
.fit-photo {
  width: 400rpx;
  height: 400rpx;
  border-radius: 56rpx;
  object-fit: cover;
  box-shadow: 0 8rpx 48rpx rgba(150, 107, 91, 0.08);
}
.fit-photo-badge {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(20rpx);
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #8B7B75;
  white-space: nowrap;
}
.design-page .fit-camera-btn {
  position: absolute;
  bottom: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFFEFB;
  border: 2rpx solid #EDE5DE;
  box-shadow: 0 8rpx 48rpx rgba(150, 107, 91, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #966B5B;
  transition: all 0.2s;
}
.design-page .fit-camera-btn:hover { background: #F5EBE7; transform: translateX(-50%) scale(1.05); }

.design-page .btn-primary {
  width: 100%;
  padding: 30rpx;
  border-radius: 32rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.design-page .btn-primary.brown {
  background: #966B5B;
  color: white;
}
.design-page .btn-primary.brown:hover { background: #7A5548; }
.design-page .btn-primary.outline {
  background: #FFFEFB;
  color: #966B5B;
  border: 3rpx solid #E8D5CF;
}
.design-page .btn-primary.outline:hover { background: #F5EBE7; }

.fit-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.fit-footer-link {
  text-align: center;
  font-size: 26rpx;
  color: #8B7B75;
}
.fit-footer-link text {
  color: #966B5B;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
}
.fit-footer-link text:hover { text-decoration: underline; }


.user-section {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 16rpx 0 40rpx;
}
.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #E8D5CF;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #966B5B;
  flex-shrink: 0;
}
.user-info .html-h3 {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.user-info .html-p {
  font-size: 24rpx;
  color: #8B7B75;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 36rpx 0;
  border-top: 2rpx solid #EDE5DE;
  border-bottom: 2rpx solid #EDE5DE;
  margin-bottom: 40rpx;
}
.stat-item {
  text-align: center;
  cursor: pointer;
  transition: opacity 0.2s;
}
.stat-item:hover { opacity: 0.7; }
.stat-item .stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #966B5B;
  margin-bottom: 8rpx;
}
.stat-item .stat-label {
  font-size: 24rpx;
  color: #8B7B75;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-header .html-h4 {
  font-size: 30rpx;
  font-weight: 700;
}
.section-header .see-all {
  font-size: 24rpx;
  color: #B5A8A2;
  cursor: pointer;
}
.section-header .see-all:hover { color: #966B5B; }

.report-card {
  background: #FFFEFB;
  border-radius: 32rpx;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
  border: 2rpx solid #EDE5DE;
  margin-bottom: 40rpx;
  position: relative;
}
.report-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 48rpx rgba(150, 107, 91, 0.08);
}
.report-card .report-bg {
  width: 100%;
  height: 240rpx;
  object-fit: cover;
  display: block;
}
.report-card .report-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(58,42,37,0.55) 0%, rgba(58,42,37,0.1) 100%);
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.report-card .report-tag {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 2rpx;
  font-weight: 600;
}
.report-card .report-title {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
}
.report-card .report-meta {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}

.menu-list {
  border-top: 2rpx solid #EDE5DE;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #EDE5DE;
  cursor: pointer;
  transition: opacity 0.2s;
}
.menu-item:hover { opacity: 0.7; }
.menu-item .menu-icon {
  width: 40rpx;
  height: 40rpx;
  color: #966B5B;
  flex-shrink: 0;
}
.menu-item .menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}
.menu-item .menu-arrow {
  color: #B5A8A2;
  font-size: 32rpx;
}


.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(58, 42, 37, 0.88);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  z-index: 9999;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
  backdrop-filter: blur(20rpx);
}
.toast.show { opacity: 1; }


@media (max-width: 1800rpx) {
  .page-header { padding: 40rpx; }
  .phone-stage { padding: 40rpx; gap: 48rpx; }
}



@keyframes scan {
  0%, 100% { top: 5%; opacity: 0; }
  10% { opacity: 1; }
  50% { top: 85%; opacity: 1; }
  90% { opacity: 1; }
}
@keyframes spin { to { transform: rotate(360deg); } }
.spin { animation: spin 1s linear infinite; }

.analysis-steps { display: flex; flex-direction: column; gap: 36rpx; }
.analysis-step {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.analysis-step .step-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.analysis-step .step-icon.check { background: #966B5B; }
.analysis-step .step-icon.spinner { color: #966B5B; }
.analysis-step .step-icon.pending { border: 3rpx solid #EDE5DE; background: transparent; }
.analysis-step .step-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #3A2A25;
}
.analysis-step:not(.done):not(.active) .step-text { color: #B5A8A2; }
.analysis-step .step-status {
  font-size: 24rpx;
  color: #8B7B75;
}


.profile-card {
  background: #F5EBE7;
  border-radius: 40rpx;
  padding: 40rpx;
  border: 2rpx solid #E8D5CF;
}
.profile-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.profile-card-tag {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #966B5B;
  font-weight: 600;
}
.profile-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  object-fit: cover;
}
.profile-card-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}
.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
}
.profile-field { display: flex; flex-direction: column; gap: 8rpx; }
.field-label { font-size: 22rpx; color: #8B7B75; }
.field-value { font-size: 28rpx; font-weight: 600; color: #3A2A25; }

.color-swatches {
  display: flex;
  gap: 32rpx;
}
.swatch-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  cursor: pointer;
  transition: transform 0.2s;
}
.swatch-item:hover { transform: scale(1.05); }
.swatch {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.swatch-item text { font-size: 24rpx; color: #8B7B75; }

.design-page .link-btn {
  background: none;
  border: none;
  color: #966B5B;
  font-size: 26rpx;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  transition: background 0.2s;
}
.design-page .link-btn:hover { background: #F5EBE7; }


.edit-group { margin-bottom: 44rpx; }
.edit-group-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #3A2A25;
}
.edit-group-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.edit-hint { font-size: 24rpx; color: #B5A8A2; }
.edit-hint-link { font-size: 26rpx; color: #B5A8A2; cursor: pointer; }
.edit-hint-link:hover { color: #966B5B; }

.chip-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}
.chip {
  padding: 18rpx 40rpx;
  border-radius: 40rpx;
  border: 3rpx solid #EDE5DE;
  font-size: 26rpx;
  font-weight: 500;
  color: #8B7B75;
  cursor: pointer;
  transition: all 0.2s;
  background: #FFFEFB;
}
.chip:hover { border-color: #E8D5CF; }
.chip.selected {
  background: #F5EBE7;
  border-color: #966B5B;
  color: #966B5B;
  font-weight: 600;
}


.product-hero {
  width: 100%;
  height: 520rpx;
  background: #FAF7F3;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.product-hero .media {
  height: 440rpx;
  object-fit: contain;
}
.product-indicator {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #B5A8A2;
}
.product-detail-brand {
  font-size: 26rpx;
  color: #966B5B;
  font-weight: 600;
  margin-top: 32rpx;
  margin-bottom: 8rpx;
}
.product-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.product-detail-name {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}
.product-detail-price {
  font-size: 48rpx;
  font-weight: 700;
  color: #3A2A25;
}
.product-detail-shade {
  font-size: 28rpx;
  color: #8B7B75;
  margin-bottom: 32rpx;
}
.divider {
  height: 2rpx;
  background: #EDE5DE;
  margin: 32rpx 0;
}
.shade-display {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 36rpx;
}
.shade-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  flex-shrink: 0;
}
.shade-name { font-size: 30rpx; font-weight: 600; margin-bottom: 4rpx; }
.shade-desc { font-size: 24rpx; color: #8B7B75; }
.product-spec-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #EDE5DE;
}
.product-spec-row:last-child { border-bottom: none; }
.spec-label { width: 140rpx; font-size: 26rpx; color: #8B7B75; }
.spec-value { flex: 1; font-size: 26rpx; font-weight: 500; }


.shade-selector {
  margin: 36rpx 0;
  padding: 28rpx;
  background: #F5EBE7;
  border-radius: 28rpx;
}
.shade-selector-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.shade-selector-title text:first-child {
  font-size: 26rpx;
  font-weight: 700;
  color: #3A2A25;
}
.shade-selector-hint {
  font-size: 22rpx;
  color: #B5A8A2;
}
.shade-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.shade-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #FFFEFB;
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
}
.shade-option:hover {
  border-color: #E8D5CF;
