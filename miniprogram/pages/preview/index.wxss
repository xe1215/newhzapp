@import "../shared.wxss";
.preview-page { padding-bottom: 40rpx; overflow: hidden; }
.preview-carousel { position: relative; height: 652rpx; margin: 40rpx -40rpx 12rpx; }
.preview-card { position: absolute; width: 472rpx; height: 616rpx; box-sizing: border-box; padding: 36rpx; border-radius: 50rpx; background: #fffdf8; box-shadow: 0 36rpx 96rpx rgba(58,45,36,.16); animation: cardIn .8s ease both; transition: transform .3s ease; }
.preview-card.center { top: 0; left: 116rpx; z-index: 5; }
.preview-card.left { top: 56rpx; left: -36rpx; z-index: 3; opacity: .78; transform: rotate(-7deg) scale(.88); }
.preview-card.right { top: 62rpx; right: -36rpx; z-index: 3; opacity: .78; transform: rotate(7deg) scale(.88); }
.preview-title { margin-top: 8rpx; font-size: 36rpx; font-weight: 900; line-height: 1; }
.preview-photo { position: relative; height: 404rpx; margin-top: 32rpx; overflow: hidden; border-radius: 36rpx; background: #e9e3dc; }
.preview-photo-b { background: #e5e4dd; }
.preview-photo-c { background: #eee1dc; }
.preview-photo image { width: 100%; height: 100%; }
.watermark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.72); font-family: Georgia,serif; font-size: 36rpx; letter-spacing: 4rpx; text-transform: uppercase; transform: rotate(-18deg); }
.note { margin-top: 18rpx; padding: 14rpx 18rpx; overflow: hidden; border-radius: 999rpx; color: #5c5048; background: rgba(233,229,220,.78); font-size: 22rpx; font-weight: 800; text-align: center; white-space: nowrap; }
.preview-pills { margin: 16rpx 0 0; gap: 10rpx; }.preview-pills .pill { flex: 1; height: 64rpx; justify-content: center; padding: 0 8rpx; font-size: 21rpx; }
.unlock-note { margin-top: 20rpx; padding: 20rpx 28rpx; border: 1rpx solid rgba(85,65,52,.16); border-radius: 36rpx; color: #837870; background: rgba(255,253,248,.64); font-size: 24rpx; font-weight: 800; line-height: 1.45; }
.fixed-actions { margin-top: 20rpx; }.state-copy { margin: 180rpx 0; color: #8c8580; text-align: center; }.image-unavailable { display: flex; width: 100%; height: 100%; box-sizing: border-box; align-items: center; justify-content: center; padding: 28rpx; color: #837870; font-size: 24rpx; font-weight: 800; text-align: center; }.retry-link { margin-top: 28rpx; color: #8c6a5a; font-size: 26rpx; font-weight: 900; }
.preview-card { border: 1rpx solid rgba(255,255,255,.9); box-shadow: 0 30rpx 72rpx rgba(67,45,34,.18); }.preview-card.center { background: #fffdf9; }.preview-pills .pill { border-color: #ead8d0; background: #fffaf6; }.unlock-note { border-color: #ead8d0; background: #fffaf7; }

/* The parent owns the card stack; the inner surface breathes without disturbing its place. */
.preview-card { padding: 0; border: 0; background: transparent; box-shadow: none; transition: transform 300ms cubic-bezier(.22,.8,.25,1), opacity 220ms ease; }
.preview-card-inner { width: 100%; height: 100%; box-sizing: border-box; padding: 36rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.9); border-radius: 50rpx; background: #fffdf9; box-shadow: 0 30rpx 72rpx rgba(67,45,34,.18); animation: preview-card-breathe 3.7s ease-in-out infinite; }
.preview-card.left .preview-card-inner { animation-delay: .35s; }
.preview-card.right .preview-card-inner { animation-delay: .7s; }
@keyframes preview-card-breathe { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14rpx); } }
.preview-carousel { touch-action: pan-y; }
.preview-stack { position: relative; width: 100%; height: 100%; transition: transform 280ms cubic-bezier(.22,.8,.25,1); }
.preview-card.center.is-dragging { transition: none; }

/* Keep the rear cards quiet: the active card alone carries the interaction. */
.preview-card-inner { animation: none; }
.preview-card.center .preview-card-inner { animation: preview-card-breathe 4.1s ease-in-out .2s infinite; }
.preview-card.center.is-dragging .preview-card-inner { animation-play-state: paused; box-shadow: 0 42rpx 92rpx rgba(67,45,34,.24); }
.preview-card { transition: transform 260ms cubic-bezier(.18,.82,.22,1), opacity 200ms ease, filter 200ms ease; }
@media (prefers-reduced-motion: reduce) {
  .preview-card,
  .preview-card-inner,
  .watermark,
  .watermark-scanline { animation: none !important; transition: none !important; }
}

/* Fan-shaped card rail, matched to the reference: one foreground card and two recessed cards. */
.preview-carousel { height: 570rpx; margin-top: 32rpx; margin-bottom: 20rpx; }
.preview-stack { overflow: visible; }
.preview-card { width: 340rpx; height: 470rpx; transform-origin: 50% 88%; transition: transform 360ms cubic-bezier(.18,.82,.22,1), opacity 220ms ease, filter 220ms ease; }
.preview-card.fan-front { top: 74rpx; left: 44rpx; z-index: 3; opacity: 1; filter: none; transform: rotate(-8deg) scale(1); }
.preview-card.fan-mid { top: 28rpx; left: 214rpx; z-index: 2; opacity: .9; filter: saturate(.88) brightness(.95); transform: rotate(-1deg) scale(.9); }
.preview-card.fan-back { top: 78rpx; left: 400rpx; z-index: 1; opacity: .78; filter: saturate(.72) brightness(.9); transform: rotate(9deg) scale(.82); }
.preview-card-motion { width: 100%; height: 100%; transition: transform 240ms cubic-bezier(.18,.82,.22,1); }
.preview-card-motion.is-dragging { transition: none; }
.preview-card-inner { padding: 28rpx; border-radius: 42rpx; }
.preview-title { margin-top: 6rpx; font-size: 32rpx; }
.preview-photo { height: 296rpx; margin-top: 24rpx; border-radius: 28rpx; }
.preview-card.fan-front .preview-card-inner { animation: preview-card-breathe 4.1s ease-in-out .2s infinite; }
.preview-card-motion.is-dragging .preview-card-inner { animation-play-state: paused; box-shadow: 0 42rpx 92rpx rgba(67,45,34,.24); }
.preview-card.fan-mid .preview-card-inner,
.preview-card.fan-back .preview-card-inner { animation: none; }
.preview-card.fan-mid .note,
.preview-card.fan-back .note { opacity: .78; }
.watermark { pointer-events: none; opacity: .48; transition: opacity 220ms ease-out; }
.watermark-active { opacity: .72; animation: watermark-reveal 480ms ease-out both; }
.watermark-scanline { position: absolute; z-index: 2; top: -20%; right: 0; left: 0; height: 48rpx; pointer-events: none; opacity: 0; background: linear-gradient(180deg,rgba(255,253,248,0),rgba(255,253,248,.72),rgba(255,253,248,0)); }
.watermark-scanline.watermark-scan { animation: watermark-scan 480ms ease-out both; }
@keyframes watermark-reveal { 0% { opacity: 0; } 55% { opacity: .8; } 100% { opacity: .72; } }
@keyframes watermark-scan { 0% { top: -20%; opacity: 0; } 16% { opacity: .95; } 100% { top: 112%; opacity: 0; } }
.preview-lightbox { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; padding: 64rpx 36rpx calc(64rpx + env(safe-area-inset-bottom)); background: rgba(31,23,20,.92); }
.lightbox-close { position: absolute; top: calc(36rpx + env(safe-area-inset-top)); right: 36rpx; min-width: 88rpx; min-height: 64rpx; box-sizing: border-box; padding: 16rpx 20rpx; border: 1rpx solid rgba(255,253,248,.32); border-radius: 999rpx; color: #fffdf8; font-size: 24rpx; font-weight: 800; text-align: center; }
.lightbox-image-wrap { position: relative; display: flex; width: 100%; max-height: 78vh; align-items: center; justify-content: center; overflow: hidden; border-radius: 36rpx; background: #211a16; }
.lightbox-image { width: 100%; max-height: 78vh; }
.lightbox-watermark { position: absolute; top: 45%; left: -16%; width: 132%; color: rgba(255,253,248,.7); font-family: Georgia,serif; font-size: 58rpx; font-weight: 800; letter-spacing: 10rpx; text-align: center; text-transform: uppercase; transform: rotate(-24deg); }
.lightbox-watermark-secondary { top: 67%; color: rgba(255,253,248,.34); }
.lightbox-caption { margin-top: 28rpx; color: rgba(255,253,248,.8); font-size: 26rpx; font-weight: 800; }

.preview-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(264rpx + env(safe-area-inset-bottom));
}

.preview-page .fixed-actions {
  position: fixed;
  right: 0;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin: 0;
}

.preview-page .fixed-actions button {
  display: flex;
  width: 396rpx;
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}
